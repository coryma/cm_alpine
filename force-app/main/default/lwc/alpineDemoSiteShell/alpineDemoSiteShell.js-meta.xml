<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Shared site shell for the Alpine demo storefront Experience pages.</description>
    <isExposed>true</isExposed>
    <masterLabel>Alpine Demo Site Shell</masterLabel>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="pageKey"
                type="String"
                default="home"
                label="Page Key"
                description="Supported values: home, products, product-detail, cart, request."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
